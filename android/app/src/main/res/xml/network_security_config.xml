<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP (cleartext) API calls from the Capacitor WebView in debug/LAN builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>