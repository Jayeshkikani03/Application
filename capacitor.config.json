{
  "appId": "com.esource.lab",
  "appName": "eSource",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "adjustMarginsForEdgeToEdge": "force"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#ffffff"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
